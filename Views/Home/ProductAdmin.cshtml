@model WebUIMVC.MyClasses.Products
@{
    ViewData["Title"] = "Product Admin";
    var oldest = Model.PL.OrderBy(x => x.intertTime).FirstOrDefault();
}
<h3>Total Products: @Model.PL.Count</h3>
@if (oldest != null)
{
    <div class="mb-3">
        <h5>Oldest Product:</h5>
        <div class="card p-2">
            <b>ASIN:</b> @oldest.asin <br />
            <b>Title:</b> @oldest.title <br />
            <b>Inserted:</b> @oldest.intertTime <br />
            <b>Updated:</b> @oldest.updated_at <br />
        </div>
    </div>
}
<hr />
<h5>Delete Products by Date Range</h5>
<form id="deleteForm" method="post" action="/Home/DeleteProductsByDateRange" onsubmit="return confirmDelete();">
    <div class="row mb-2">
        <div class="col-md-4">
            <label>Start Date/Time</label>
            <input type="datetime-local" name="start" id="startDate" class="form-control" required />
        </div>
        <div class="col-md-4">
            <label>End Date/Time</label>
            <input type="datetime-local" name="end" id="endDate" class="form-control" required />
        </div>
        <div class="col-md-4 d-flex align-items-end">
            <button type="button" class="btn btn-danger" onclick="showDeleteModal()">Delete Products</button>
        </div>
    </div>
<!-- Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1" role="dialog" aria-labelledby="deleteModalLabel" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="deleteModalLabel">Confirm Deletion</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body" id="deleteModalBody">
                <!-- Content set by JS -->
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-danger" onclick="submitDeleteForm()">Yes, Delete</button>
            </div>
        </div>
    </div>
</div>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/js/bootstrap.bundle.min.js"></script>
<script>
        // Prepare a JS array of product insert times from the model
        var productTimes = [
                @foreach (var p in Model.PL)
                {
                        @: { dt: new Date("@p.intertTime.ToString("yyyy-MM-ddTHH:mm:ss")"), readit: @p.readit },
                }
        ];

        function showDeleteModal() {
                var start = document.getElementById('startDate').value;
                var end = document.getElementById('endDate').value;
                if (!start || !end) {
                        alert('Please select both start and end date/time.');
                        return;
                }
                var startDate = new Date(start);
                var endDate = new Date(end);
                // Only count non-wishlisted items (readit != 4)
                var count = productTimes.filter(function(p) {
                        return p.readit != 4 && p.dt >= startDate && p.dt <= endDate;
                }).length;
                var msg = 'Are you sure you want to delete <b>' + count + '</b> non-wishlisted products in the selected date/time range? This cannot be undone.';
                document.getElementById('deleteModalBody').innerHTML = msg;
                $('#deleteModal').modal('show');
        }
        function submitDeleteForm() {
                $('#deleteModal').modal('hide');
                document.getElementById('deleteForm').submit();
        }
</script>
@if (TempData["DeleteResult"] != null)
{
    <div class="alert alert-info mt-3">@TempData["DeleteResult"]</div>
}
</form>

@if (TempData["DeleteResult"] != null)
{
    <div class="alert alert-info mt-3">@TempData["DeleteResult"]</div>
}
